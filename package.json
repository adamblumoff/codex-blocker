{
  "name": "codex-blocker-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter codex-blocker --filter @codex-blocker/extension dev",
    "dev:all": "pnpm -r --parallel dev",
    "dev:mobile": "pnpm --filter @codex-blocker/mobile dev -- --tunnel --clear",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && rm -rf coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.6",
    "jsdom": "^25.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6"
  },
  "version": "",
  "dependencies": {
    "codex-blocker": "workspace:0.1.4"
  }
}
